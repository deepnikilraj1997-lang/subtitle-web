# ── Required — set this as an env var on Railway/Render ─────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Optional ────────────────────────────────────────────────────────────────
PORT=3000
WHISPER_MODEL=whisper-large-v3-turbo
TRANSLATION_MODEL=llama-3.3-70b-versatile
MAX_LINE_LENGTH=42
MERGE_GAP=0.3

# Max upload size in MB (Groq limit is 25 MB)
MAX_UPLOAD_MB=25
